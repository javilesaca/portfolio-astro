---
/**
 * Base Layout — JaviLesacaPro Portfolio
 * Root layout with SEO, JSON-LD, fonts, global styles, skip link.
 */
interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const {
  title = 'JaviLesacaPro',
  description = 'Portfolio de Javier Lesaca, IT Infrastructure & Software Developer.',
  ogImage = '/preview.jpg',
} = Astro.props;

const site = import.meta.env.SITE || 'https://javilesaca.pro';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Javier Lesaca',
  jobTitle: 'IT Infrastructure & Software Developer',
  url: site,
  image: new URL('/preview.jpg', site).href,
  sameAs: [
    'https://github.com/javilesaca',
    'https://linkedin.com/in/javilesacapro',
  ],
  knowsAbout: [
    'IT Infrastructure',
    'Backend Development',
    'API Design',
    'Database Design',
    'Cloud Architecture',
    'DevOps',
    'Applied AI',
    'Software Architecture',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Jaén',
    addressCountry: 'ES',
  },
};

import '../styles/tokens.css';
import '../styles/global.css';
import BackgroundBlobs from '../components/BackgroundBlobs.astro';

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'JaviLesacaPro',
  url: site,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${site}/search?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>{title} | JaviLesacaPro</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#2e8b57" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#181818" media="(prefers-color-scheme: dark)" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={new URL(Astro.url.pathname, site).href} />
  <meta property="og:image" content={new URL(ogImage, site).href} />
  <meta property="og:site_name" content="JaviLesacaPro" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, site).href} />

  <!-- Canonical -->
  <link rel="canonical" href={new URL(Astro.url.pathname, site).href} />

  <!-- Preconnect fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'" />

  <!-- JSON-LD Person -->
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

  <!-- JSON-LD WebSite -->
  <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />


</head>
<body>
  <!-- Skip link for accessibility -->
  <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

  <BackgroundBlobs />

  <slot name="header" />

  <main id="main-content" role="main" class="content-layer">
    <slot />
  </main>

  <div class="content-layer">
    <slot name="footer" />
  </div>

  <style>
    .content-layer {
      position: relative;
      z-index: var(--z-content);
    }
  </style>

  <!-- Analytics (Plausible/Umami) - add script here when configured -->
  <script is:inline>
    // Analytics placeholder - replace with Plausible/Umami script
    if (import.meta.env.PROD) {
      // window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) };
    }
  </script>
</body>
</html>