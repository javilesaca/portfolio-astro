---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ id }) => id.startsWith('es/'))).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
---
<BaseLayout title="Javier Lesaca — IT Infrastructure & Software Developer" description="Portfolio de Javier Lesaca, IT Infrastructure & Software Developer. Infraestructura, software, automatización e IA.">
  <Header slot="header" />
  <Hero />
  <section id="proyectos" class="section" aria-labelledby="proyectos-title">
    <div class="container">
      <h2 id="proyectos-title">Proyectos</h2>
      <p class="lead">Selección de proyectos con case study: contexto, retos técnicos y aprendizajes.</p>
      <div class="grid">
        {projects.map((p) => (
          <ProjectCard title={p.data.title} shortDescription={p.data.shortDescription} techStack={p.data.techStack} role={p.data.role} image={p.data.image} imageAlt={p.data.imageAlt} repoUrl={p.data.repoUrl} demoUrl={p.data.demoUrl} slug={p.id.replace(/^es\//,"").replace(/\.mdx?$/,"")} />
        ))}
      </div>
    </div>
  </section>
  <section id="sobre-mi" class="section" aria-labelledby="sobre-title">
    <div class="container container--narrow">
      <h2 id="sobre-title">Sobre mí</h2>
      <p>Soy profesional tecnológico con una trayectoria construida desde la infraestructura IT —sistemas, redes, servidores y seguridad— hasta el desarrollo de software, la automatización y la IA aplicada. Combino experiencia técnica con visión de negocio para transformar necesidades empresariales en soluciones tecnológicas.</p>
      <p>He trabajado en administración y optimización de infraestructuras, continuidad de negocio, soporte y consultoría tecnológica, incluyendo proyectos de implantación para organizaciones y administraciones públicas. Hoy completo ese perfil con desarrollo multiplataforma, trabajando con Java, C#, Python, SQL/NoSQL, Spring Boot y Git, además de IA generativa, automatización y agentes autónomos.</p>
      <p>Busco posiciones donde unir ambos mundos: infraestructura y operaciones IT con software, automatización e IA — creando, integrando y modernizando soluciones.</p>
      <ul class="areas" aria-label="Áreas de experiencia">
        <li>Infraestructura & Redes</li>
        <li>Desarrollo de Software</li>
        <li>Automatización</li>
        <li>IA aplicada & Agentes</li>
      </ul>
    </div>
  </section>
  <section id="contacto" class="section" aria-labelledby="contacto-title">
    <div class="container container--narrow">
      <h2 id="contacto-title">Contacto</h2>
      <p class="lead">¿Tienes una propuesta o quieres solicitar mi currículum? Escríbeme.</p>
      <form name="contacto" method="POST" action="https://formspree.io/f/mppwbnon" class="form">
        <p class="visually-hidden"><label>No rellenar: <input name="_gotcha" tabindex="-1" autocomplete="off" /></label></p>
        <input type="hidden" name="_subject" value="Nuevo mensaje desde el portfolio" />
        <label for="nombre">Nombre<input id="nombre" name="nombre" required autocomplete="name" /></label>
        <label for="email">Email<input id="email" name="email" type="email" required autocomplete="email" /></label>
        <label for="mensaje">Mensaje<textarea id="mensaje" name="mensaje" rows="5" required></textarea></label>
        <button class="btn btn--primary btn--md" type="submit">Enviar mensaje</button>
        <p class="form__status" data-form-status role="status" aria-live="polite" hidden></p>
      </form>
      <script>
        const form = document.querySelector('form[name="contacto"]');
        const status = document.querySelector('[data-form-status]');
        form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!form || !status) return;
          const btn = form.querySelector('button[type="submit"]');
          status.hidden = false;
          status.textContent = 'Enviando…';
          if (btn instanceof HTMLButtonElement) btn.disabled = true;
          try {
            const res = await fetch(form.action, {
              method: 'POST',
              body: new FormData(form),
              headers: { Accept: 'application/json' },
            });
            if (!res.ok) throw new Error('send failed');
            form.reset();
            status.textContent = '¡Mensaje enviado! Te responderé lo antes posible.';
          } catch {
            status.textContent = 'No se pudo enviar. Escríbeme a javilesaca@javilesaca.pro';
          } finally {
            if (btn instanceof HTMLButtonElement) btn.disabled = false;
          }
        });
      </script>
      <p class="alt">O por email: <a href="mailto:javilesaca@javilesaca.pro">javilesaca@javilesaca.pro</a></p>
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>
<style>
.lead{color:var(--color-text-muted);font-size:var(--text-lg);margin:.5rem 0 2rem}
.container--narrow{max-width:var(--container-md)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(17rem,1fr));gap:var(--space-6);margin-top:var(--space-8)}
.form{display:grid;gap:var(--space-4);margin-top:var(--space-6);text-align:left}
.form label{display:grid;gap:var(--space-2)}
.section h2{margin-bottom:var(--space-8)}
.alt{margin-top:var(--space-4);color:var(--color-text-muted)}
.areas{display:flex;flex-wrap:wrap;gap:var(--space-2);list-style:none;margin:var(--space-6) 0 0;padding:0;justify-content:center}
.areas li{font-size:var(--text-sm);font-weight:var(--font-weight-medium);border:1px solid currentColor;border-radius:var(--radius-full);padding:var(--space-2) var(--space-4);color:var(--color-text)}
</style>
