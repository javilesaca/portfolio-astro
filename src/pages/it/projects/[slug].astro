---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id.replace(/\.mdx?$/,"") }, props: { project: p } }));
}
const lang = "it" as const;
const { project } = Astro.props;
const { Content } = await render(project);
---
<BaseLayout lang={lang} title={`${project.data.title} — Case study`} description={project.data.description} ogImage={project.data.image.src}>
  <Header slot="header" lang={lang} />
  <article class="section container container--narrow">
    <a href="/it/#proyectos">← Torna ai progetti</a>
    <p class="role">{project.data.role} · {project.data.status}</p>
    <h1>{project.data.title}</h1>
    <p class="lead">{project.data.description}</p>
    <Image src={project.data.image} alt={project.data.imageAlt} width={1200} formats={['avif', 'webp']} class="cover" />
    <h2>Stack</h2>
    <ul class="tags">{project.data.techStack.map((t) => <li>{t}</li>)}</ul>
    <h2>Sfide</h2>
    <ul>{project.data.challenges.map((c) => <li>{c}</li>)}</ul>
    <h2>Apprendimenti</h2>
    <ul>{project.data.learnings.map((l) => <li>{l}</li>)}</ul>
    <Content />
    {project.data.metrics && (
      <><h2>Metriche</h2><dl class="metrics">{project.data.metrics.map((m) => <div><dt>{m.label}</dt><dd>{m.value}</dd></div>)}</dl></>
    )}
    <div class="links">
      <a href={project.data.repoUrl} target="_blank" rel="noopener noreferrer">Repository ↗</a>
      {project.data.demoUrl && <a href={project.data.demoUrl} target="_blank" rel="noopener noreferrer">Demo live ↗</a>}
    </div>
  </article>
  <Footer slot="footer" />
</BaseLayout>
<style>
.role{color:var(--color-brand);font-weight:600;text-transform:uppercase;font-size:var(--text-sm)}
.lead{color:var(--color-text-muted);font-size:var(--text-lg);margin:1rem 0}
.cover{border-radius:var(--radius-lg);margin:1.5rem 0}
.tags{display:flex;flex-wrap:wrap;gap:.5rem;list-style:none}
.tags li{font-family:var(--font-mono);font-size:.8rem;background:var(--color-brand-muted);padding:.25rem .5rem;border-radius:.25rem}
.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(8rem,1fr));gap:1rem;margin:1rem 0}
.metrics dt{font-size:.8rem;color:var(--color-text-muted)}
.metrics dd{font-size:1.25rem;font-weight:700}
.links{display:flex;gap:1.5rem;margin-top:2rem}
.container--narrow{max-width:56rem}
ul{margin:.5rem 0 1.5rem 1.25rem}
</style>
