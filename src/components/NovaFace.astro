---
/**
 * NovaFace — la cara de NOVA.
 *
 * Inspirada en robots de cine (pantalla oscura + ojos luminosos) pero con
 * diseño propio: proporciones, color y nombre originales.
 *
 * CÓMO FUNCIONA:
 * - El componente dibuja ojos + boca en SVG. Cada EXPRESIÓN es un conjunto
 *   de formas; solo una visible a la vez (atributo data-expression).
 * - `NovaWidget` (u otro padre) cambia la expresión con:
 *     document.querySelector('#nova-face').dataset.expression = 'thinking'
 * - La "vida" (parpadeo, mirada que sigue el cursor) va en el <script> de abajo.
 * - Accesibilidad: role="img" con aria-label, y si el usuario prefiere menos
 *   movimiento (prefers-reduced-motion) se congela la animación.
 */
interface Props {
  /** Expresión inicial. */
  expression?: 'idle' | 'thinking' | 'speaking' | 'happy' | 'confused';
}
const { expression = 'idle' } = Astro.props;
---

<div
  id="nova-face"
  class="nova-face"
  data-expression={expression}
  role="img"
  aria-label="NOVA, la asistente del portfolio"
>
  <svg viewBox="0 0 200 160" aria-hidden="true">
    <!-- Pantalla: el "casco" oscuro de NOVA -->
    <rect x="10" y="10" width="180" height="140" rx="42" class="face__screen" />

    <!-- OJOS IDLE: dos óvalos luminosos (pupilas en grupo para moverlas) -->
    <g class="eyes eyes--idle">
      <ellipse cx="70" cy="70" rx="20" ry="26" class="eye" />
      <ellipse cx="130" cy="70" rx="20" ry="26" class="eye" />
      <g class="pupils">
        <circle cx="70" cy="74" r="8" class="pupil" />
        <circle cx="130" cy="74" r="8" class="pupil" />
      </g>
    </g>

    <!-- OJOS THINKING: entrecerrados, mirada al lateral (investigando) -->
    <g class="eyes eyes--thinking">
      <ellipse cx="70" cy="72" rx="20" ry="14" class="eye" />
      <ellipse cx="130" cy="72" rx="20" ry="14" class="eye" />
      <g class="pupils pupils--side">
        <circle cx="78" cy="72" r="7" class="pupil" />
        <circle cx="138" cy="72" r="7" class="pupil" />
      </g>
    </g>

    <!-- OJOS HAPPY: arcos ^ ^ (contenta con su respuesta) -->
    <g class="eyes eyes--happy">
      <path d="M48 78 Q70 50 92 78" class="eye-stroke" />
      <path d="M108 78 Q130 50 152 78" class="eye-stroke" />
    </g>

    <!-- OJOS CONFUSED: uno alto y otro bajo (no entendió) -->
    <g class="eyes eyes--confused">
      <ellipse cx="70" cy="60" rx="18" ry="22" class="eye" />
      <ellipse cx="130" cy="80" rx="18" ry="22" class="eye" />
      <circle cx="70" cy="63" r="7" class="pupil" />
      <circle cx="130" cy="83" r="7" class="pupil" />
    </g>

    <!-- BOCA: una línea de luz; su forma depende de la expresión.
         Hablando: se anima (abre/cierra) con CSS mientras dura la respuesta. -->
    <g class="mouth">
      <path d="M80 120 Q100 132 120 120" class="mouth__smile" />
      <line x1="80" y1="122" x2="120" y2="122" class="mouth__flat" />
      <path d="M78 118 Q100 142 122 118 Q100 128 78 118" class="mouth__grin" />
      <path d="M80 120 Q90 116 100 122 Q110 128 120 120" class="mouth__wavy" />
      <ellipse cx="100" cy="124" rx="10" ry="12" class="mouth__talk" />
    </g>
  </svg>
</div>

<script>
  // VIDA DE NOVA: parpadeo + mirada. Todo aquí es cosmético: si falla,
  // la cara sigue funcionando (las expresiones las pone el atributo).
  const face = document.querySelector('#nova-face');
  if (face && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // Parpadeo: cada 2.5–5.5 s los ojos se "aplanan" 150 ms.
    // Se salta en happy (los ojos ya son arcos) para no romper la forma.
    const blink = () => {
      if (face.dataset.expression !== 'happy') {
        face.classList.add('is-blinking');
        setTimeout(() => face.classList.remove('is-blinking'), 150);
      }
      setTimeout(blink, 2500 + Math.random() * 3000);
    };
    setTimeout(blink, 2000);

    // Mirada: las pupilas idle siguen el cursor (máx. 6 px, sutil).
    const pupils = face.querySelector('.eyes--idle .pupils');
    const svg = face.querySelector('svg');
    document.addEventListener('mousemove', (e) => {
      if (!pupils || !svg) return;
      const r = svg.getBoundingClientRect();
      const dx = (e.clientX - (r.left + r.width / 2)) / r.width;
      const dy = (e.clientY - (r.top + r.height / 2)) / r.height;
      pupils.setAttribute(
        'transform',
        `translate(${(dx * 12).toFixed(1)}, ${(dy * 8).toFixed(1)})`
      );
    });
  }
</script>

<style>
  .nova-face { width: 200px; max-width: 60vw; }
  .nova-face svg { width: 100%; height: auto; display: block; }

  .face__screen { fill: #0d1526; stroke: #22d3ee33; stroke-width: 2; }
  .eye { fill: #67e8f9; }
  .pupil { fill: #0b0e14; }
  .eye-stroke {
    fill: none; stroke: #67e8f9; stroke-width: 9; stroke-linecap: round;
  }
  .mouth path, .mouth line {
    fill: none; stroke: #67e8f9; stroke-width: 5; stroke-linecap: round;
  }
  .mouth__talk { fill: #67e8f9; stroke: none; }

  /* Solo la expresión activa es visible. Por defecto (sin atributo) idle. */
  .eyes, .mouth > * { display: none; }
  .nova-face[data-expression='idle'] .eyes--idle,
  .nova-face[data-expression='thinking'] .eyes--thinking,
  .nova-face[data-expression='speaking'] .eyes--idle,
  .nova-face[data-expression='happy'] .eyes--happy,
  .nova-face[data-expression='confused'] .eyes--confused { display: block; }

  .nova-face[data-expression='idle'] .mouth__smile,
  .nova-face[data-expression='thinking'] .mouth__flat,
  .nova-face[data-expression='happy'] .mouth__grin,
  .nova-face[data-expression='confused'] .mouth__wavy,
  .nova-face[data-expression='speaking'] .mouth__talk { display: block; }

  /* Hablando: la boca "mastica" (escala vertical rítmica). */
  .nova-face[data-expression='speaking'] .mouth__talk {
    transform-origin: 100px 124px;
    animation: talk 0.5s ease-in-out infinite alternate;
  }
  @keyframes talk { from { transform: scaleY(0.4); } to { transform: scaleY(1.3); } }

  /* Parpadeo: aplasta solo los ojos idle. */
  .nova-face.is-blinking .eyes--idle {
    transform-origin: 100px 70px;
    animation: blink 0.15s linear;
  }
  @keyframes blink { to { transform: scaleY(0.08); } }

  /* Thinking: balanceo suave (está "dando vueltas" a la pregunta). */
  .nova-face[data-expression='thinking'] svg {
    transform-origin: 100px 80px;
    animation: sway 2.4s ease-in-out infinite alternate;
  }
  @keyframes sway { from { transform: rotate(-2deg); } to { transform: rotate(2deg); } }

  /* Sin movimiento: todo quieto, expresiones intactas. */
  @media (prefers-reduced-motion: reduce) {
    .nova-face * { animation: none !important; }
  }
</style>
