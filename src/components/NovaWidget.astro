---
/**
 * NovaWidget — dock flotante de NOVA (hito 2, revisión flotante).
 *
 * Colapsado: rectángulo redondeado translúcido con la cara abajo-derecha.
 * Abierto: panel de diálogo con LA MISMA transparencia que el botón, y la
 * cara ENCIMA del diálogo (no desaparece): gesticula mientras NOVA piensa
 * y "habla" (mueve la boca) mientras escribe la respuesta.
 * La CARA nunca es semitransparente: su pantalla LED es sólida (#05080f).
 *
 * Montado en BaseLayout → acompaña toda la navegación (cada página Astro
 * lo re-renderiza; el estado abierto/cerrado sobrevive vía sessionStorage).
 *
 * Máquina de estados de la cara: idle · thinking · speaking · happy · confused.
 * Backend: PUBLIC_NOVA_ENDPOINT (por defecto http://localhost:8091/api/ask;
 * en producción: /api/ask.php relativo al mismo dominio, servido por nova-stellar).
 */
import NovaFace from './NovaFace.astro';

const endpoint = import.meta.env.PUBLIC_NOVA_ENDPOINT ?? 'http://localhost:8091/api/ask';
---

<div class="nova-dock" data-endpoint={endpoint} data-open="false">
  <!-- ELEMENTO 3: bocadillo de inactividad (ver JS: tras 1 min sin
       interactuar con el dock minimizado, visible 5 s, cada 3 min). -->
  <div class="nova-teaser" hidden>
    <span>Hola, soy NOVA y estoy aquí para ayudarte.</span>
    <button type="button" class="nova-teaser__close" aria-label="Ocultar aviso">✕</button>
  </div>
  <!-- FIN ELEMENTO 3 -->
  <!-- Botón flotante (solo cuando el diálogo está cerrado) -->
  <button
    type="button"
    class="nova-dock__fab"
    aria-expanded="false"
    aria-controls="nova-panel"
    aria-label="Abrir chat con NOVA"
  >
    <NovaFace id="nova-face-fab" expression="idle" />
  </button>

  <!-- Diálogo: misma transparencia que el botón + cara encima -->
  <section
    id="nova-panel"
    class="nova-dock__panel"
    aria-label="Chat con NOVA"
    hidden
  >
    <div class="nova-dock__face">
      <NovaFace id="nova-face-panel" expression="idle" />
    </div>

    <header class="nova-dock__head">
      <strong>NOVA</strong>
      <span class="nova-dock__sub">Tu atajo para evaluar este perfil</span>
      <button type="button" class="nova-dock__close" aria-label="Cerrar chat">✕</button>
    </header>

    <div class="nova__log" role="log" aria-live="polite" aria-label="Conversación con NOVA">
      <p class="nova__msg nova__msg--nova">¡Hola! Soy <strong>NOVA</strong>. Pregúntame por Javier y sus proyectos… con pruebas, no de palabra.</p>
    </div>

    <!-- ELEMENTO 5: chips dinámicos según página/contexto -->
    <div class="nova__chips" role="group" aria-label="Preguntas sugeridas"></div>
    <!-- FIN ELEMENTO 5 -->
    <form class="nova__form">
      <label class="visually-hidden" for="nova-input">Pregunta para NOVA</label>
      <textarea id="nova-input" rows="3" placeholder="Ej. ¿Qué proyecto usa eventos en tiempo real?" autocomplete="off"></textarea>
      <button type="submit">Preguntar</button>
    </form>

    <div class="nova__sources" hidden>
      <h3>Fuentes</h3>
      <ul></ul>
    </div>
  </section>
</div>

<script>
  // Controlador del dock. Sin frameworks: estado en data-open + sessionStorage.
  const dock = document.querySelector('.nova-dock');
  const fab = dock?.querySelector('.nova-dock__fab');
  const panel = dock?.querySelector('.nova-dock__panel');
  const closeBtn = dock?.querySelector('.nova-dock__close');
  const faces = dock?.querySelectorAll('.nova-face');
  const log = dock?.querySelector('.nova__log');
  const form = dock?.querySelector('.nova__form');
  const input = dock?.querySelector('#nova-input');
  const sources = dock?.querySelector('.nova__sources');
  const sourcesList = sources?.querySelector('ul');
  const api = dock?.dataset.endpoint ?? 'http://localhost:8091/api/ask';
  // Memoria mínima de seguimiento (igual que nova-stellar): último proyecto
  // citado distinto de 'cv'; viaja como {question, context}. Sin citas no se olvida.
  let lastProject = null;

  const KEY = 'nova-dock-open';

  const teaser = dock?.querySelector('.nova-teaser');
  // Ritmo del bocadillo de inactividad: cada 3 min se comprueba si lleva
  // 1 min sin interactuar con el dock minimizado; de ser así se muestra 5 s.
  const IDLE_MS = 60 * 1000;
  const TEASER_MS = 5 * 1000;
  const EVERY_MS = 3 * 60 * 1000;
  let lastInteract = Date.now();
  const touch = () => { lastInteract = Date.now(); };
  const hideTeaser = () => { if (teaser) teaser.hidden = true; };

  /** Abre/cierra el panel. Un solo punto de cambio. */
  const setOpen = (open, focus = true) => {
    dock?.setAttribute('data-open', String(open));
    if (panel) panel.hidden = !open;
    fab?.setAttribute('aria-expanded', String(open));
    fab?.setAttribute('aria-label', open ? 'Cerrar chat con NOVA' : 'Abrir chat con NOVA');
    try { sessionStorage.setItem(KEY, open ? '1' : '0'); } catch { /* privado: sin memoria */ }
    touch();
    if (open) { hideTeaser(); if (focus) input?.focus(); }
  };

  // Permite que la sección "Pregúntale a NOVA" (y el CTA de cada proyecto)
  // abra el dock: document.dispatchEvent(new CustomEvent('nova:open',
  // {detail: {project, question}})). Con detail, fija el contexto de memoria,
  // precarga la pregunta y la envía (mismo patrón que los chips).
  document.addEventListener('nova:open', (e) => {
    setOpen(true);
    const detail = e instanceof CustomEvent ? e.detail ?? {} : {};
    if (typeof detail.project === 'string' && detail.project) {
      lastProject = detail.project;
    }
    if (typeof detail.question === 'string' && detail.question && input && form && !form.dataset.busy) {
      input.value = detail.question;
      form.requestSubmit();
    }
  });

  fab?.addEventListener('click', () => setOpen(dock?.dataset.open !== 'true'));
  closeBtn?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && dock?.dataset.open === 'true') { setOpen(false); fab?.focus(); }
  });

  // El dock abierto sobrevive a la navegación: se restaura en silencio
  // (sin robar el foco) para no descolocar al usuario en cada página.
  try { if (sessionStorage.getItem(KEY) === '1') setOpen(true, false); } catch { /* nada */ }

  /** Cambia la expresión en AMBAS caras (botón y panel) a la vez. */
  const setFace = (expr) => faces?.forEach((f) => f.setAttribute('data-expression', expr));
  const currentFace = () => faces?.[0]?.dataset.expression;

  const addMsg = (who, text) => {
    const p = document.createElement('p');
    p.className = 'nova__msg nova__msg--' + who;
    // Los estilos van con scope de Astro: el HTML estático lo trae, pero los
    // nodos creados en vivo deben copiar el atributo o quedan sin estilos.
    const scope = [...(log?.attributes ?? [])].find((a) => a.name.startsWith('data-astro-cid'));
    if (scope) p.setAttribute(scope.name, '');
    p.textContent = text;
    log?.appendChild(p);
    p.scrollIntoView({ block: 'nearest' });
    return p;
  };

  // Enlaza la primera mención de cada proyecto citado dentro del texto.
  // Nombre corto = título sin paréntesis ("Panel de Eventos (EventDashboard)"
  // se menciona como "Panel de Eventos"). Solo nodos de texto: sin HTML inyectado.
  const linkify = (el, enlaces) => {
    enlaces.slice().sort((a, b) => b.name.length - a.name.length).forEach(({ name, href }) => {
      const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
      const nodos = [];
      while (walker.nextNode()) nodos.push(walker.currentNode);
      for (const node of nodos) {
        const idx = node.textContent.toLowerCase().indexOf(name.toLowerCase());
        if (idx === -1) continue;
        const medio = node.splitText(idx);
        const resto = medio.splitText(name.length);
        void resto;
        const a = document.createElement('a');
        a.href = href;
        a.className = 'nova__link';
        a.textContent = medio.textContent;
        medio.replaceWith(a);
        break;
      }
    });
  };
  const typewriter = (el, text) => new Promise((resolve) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = text;
      resolve();
      return;
    }
    let i = 0;
    let n = 0;
    const tick = () => {
      el.textContent = text.slice(0, i += 1);
      // Sigue el texto mientras escribe (cada 4 letras, para no saturar).
      if (++n % 4 === 0) el.scrollIntoView({ block: 'nearest' });
      if (i < text.length) setTimeout(tick, 24);
      else { el.scrollIntoView({ block: 'nearest' }); resolve(); }
    };
    tick();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    touch();
    const question = input?.value.trim();
    if (!question || form.dataset.busy) return;
    form.dataset.busy = '1';
    input.value = '';
    addMsg('user', question);
    setFace('thinking'); // NOVA investiga: ojos entrecerrados, cara visible encima.
    const pending = addMsg('nova', 'Consultando mis fuentes…');

    try {
      const res = await fetch(api, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question, context: lastProject }),
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      const primera = (data.citations ?? []).find((c) => c && c.project && c.project !== 'cv');
      if (primera) { lastProject = primera.project; }

      setFace('speaking'); // NOVA responde: la boca se mueve mientras escribe.
      await typewriter(pending, data.answer);

      // Sin panel de Fuentes: el texto respira. Las citas siguen usándose
      // para memoria de contexto (lastProject) y la expresión (knows).
      const cites = data.citations ?? [];
      if (sources) sources.hidden = true;
      // Enlaces en el texto: cada proyecto citado enlaza su ficha en el idioma actual.
      const seg = location.pathname.split('/')[1];
      const base = { en: '/en/projects/', fr: '/fr/projects/', it: '/it/projects/', de: '/de/projects/', pt: '/pt/projects/' }[seg] ?? '/proyectos/';
      const vistos = new Set();
      const enlaces = [];
      cites.forEach((c) => {
        if (!c || !c.project || c.project === 'cv' || vistos.has(c.project)) return;
        vistos.add(c.project);
        const corto = String(c.title || c.project).replace(/\s*\(.*?\)\s*/g, '').trim() || c.project;
        enlaces.push({ name: corto, href: base + c.project + '/' });
      });
      linkify(pending, enlaces);
      const knows = cites.length > 0 && !/no (dispongo|tengo)/i.test(data.answer);
      setFace(knows ? 'happy' : 'confused');
    } catch (err) {
      pending.textContent = 'No pude contactar con mi cerebro (¿está NOVA en marcha?).';
      setFace('confused');
    } finally {
      delete form.dataset.busy;
      setTimeout(() => {
        const expr = currentFace();
        if (expr === 'happy' || expr === 'confused') setFace('idle');
      }, 4000);
    }
  });

  // ELEMENTO 3: bocadillo de inactividad. Cada 3 min: si el dock sigue
  // minimizado, no está ocupado y lleva 1 min sin interactuar, se muestra
  // 5 s. Cualquier interacción reinicia el contador.
  teaser?.querySelector('.nova-teaser__close')?.addEventListener('click', (e) => {
    e.stopPropagation();
    hideTeaser();
    touch();
  });
  teaser?.addEventListener('click', () => setOpen(true));
  setInterval(() => {
    if (!teaser || dock?.dataset.open === 'true') return;
    if (form?.dataset.busy) return;
    if (Date.now() - lastInteract < IDLE_MS) return;
    teaser.hidden = false;
    setTimeout(() => { if (dock?.dataset.open !== 'true') teaser.hidden = true; }, TEASER_MS);
  }, EVERY_MS);
  // FIN ELEMENTO 3

  // ELEMENTO 5: chips dinámicos según página/contexto.
  // Home: preguntas generales; Proyecto: específicas del proyecto (en su idioma).
  const chipsContainer = dock?.querySelector('.nova__chips');
  const lang = document.documentElement.lang || 'es';
  const path = location.pathname;
  const isProject = path.includes('/proyectos/') || path.includes('/projects/') || path.includes('/projets/') || path.includes('/progetti/') || path.includes('/projekte/');
  const projectSlug = isProject ? (path.split('/proyectos/')[1]?.split('/')[0] || path.split('/projects/')[1]?.split('/')[0]) : null;

  const chipSets = {
    es: { home: ['¿Qué experiencia tiene?', '¿Qué proyectos usan IA?', '¿Por qué contratarle?'],
          project: (slug) => ['¿Qué stack usa ' + slug + '?', '¿Qué retos tuvo ' + slug + '?', '¿Qué tecnologías usa ' + slug + '?'] },
    en: { home: ['What is the experience?', 'Which projects use AI?', 'Why hire?'],
          project: (slug) => ['What stack does ' + slug + ' use?', 'What challenges did ' + slug + ' face?', 'What technologies in ' + slug + '?'] },
    fr: { home: ["Quelle est l'expérience ?", "Quels projets utilisent l'IA ?", "Pourquoi l'embaucher ?"],
          project: (slug) => ["Quelle stack pour " + slug + " ?", "Quels défis pour " + slug + " ?", "Quelles technologies dans " + slug + " ?"] },
    it: { home: ["Qual è l'esperienza?", "Quali progetti usano l'IA?", "Perché assumerlo?"],
          project: (slug) => ["Che stack usa " + slug + "?", "Quali sfide ha avuto " + slug + "?", "Quali tecnologie in " + slug + "?"] },
    de: { home: ['Was ist die Erfahrung?', 'Welche Projekte nutzen KI?', 'Warum einstellen?'],
          project: (slug) => ['Welchen Stack nutzt ' + slug + '?', 'Welche Herausforderungen hatte ' + slug + '?', 'Welche Technologien in ' + slug + '?'] },
    pt: { home: ['Qual é a experiência?', 'Quais projetos usam IA?', 'Por que contratar?'],
          project: (slug) => ['Qual stack o ' + slug + ' usa?', 'Quais desafios o ' + slug + ' teve?', 'Quais tecnologias no ' + slug + '?'] }
  };
  const t = chipSets[lang] || chipSets.es;
  const questions = isProject && projectSlug ? t.project(projectSlug) : t.home;
  if (chipsContainer && questions.length) {
    chipsContainer.innerHTML = questions.map(q => '<button type="button" data-q="' + q + '">' + q + '</button>').join('');
    // Los botones nacen en vivo por innerHTML: sin el atributo de scope de
    // Astro quedan sin estilos (la misma razón documentada en addMsg).
    // Se lo copiamos del contenedor, que sí lo trae del HTML estático.
    const scope = [...(chipsContainer.attributes ?? [])].find((a) => a.name.startsWith('data-astro-cid'));
    if (scope) chipsContainer.querySelectorAll('button').forEach((b) => b.setAttribute(scope.name, ''));
  }
  chipsContainer?.addEventListener('click', (e) => {
    const chip = e.target.closest('[data-q]');
    if (!chip) return;
    touch();
    if (input) input.value = chip.dataset.q ?? '';
    form?.requestSubmit();
  });
  // FIN ELEMENTO 5

  // Mientras el usuario escribe, NOVA pone cara de concentración.
  // Al vaciar o salir del campo, vuelve a reposo (salvo que esté ocupada).
  input?.addEventListener('input', () => {
    touch();
    if (form?.dataset.busy) return;
    setFace(input.value.trim() ? 'thinking' : 'idle');
  });
  input?.addEventListener('blur', () => {
    if (!form?.dataset.busy && !input.value.trim()) setFace('idle');
  });

  // Enter envía (Shift+Enter = salto de línea), como en los chats de verdad.
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      form?.requestSubmit();
    }
  });
</script>

<style>
  /* Dock fijo abajo-derecha, por encima del contenido pero bajo el header móvil */
  .nova-dock {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: var(--z-sticky);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: .6rem;
  }

  /* ELEMENTO 3: bocadillo teaser (borrar bloque para quitarlo) */
  .nova-teaser {
    display: flex; align-items: center; gap: .5rem;
    max-width: 16rem;
    padding: .55rem .8rem;
    font-size: var(--text-sm);
    background: color-mix(in srgb, #05080f 55%, transparent);
    border: 1px solid var(--color-primary);
    border-radius: 12px 12px 4px 12px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: var(--shadow-lg);
    cursor: pointer;
  }
  .nova-teaser[hidden] { display: none; }
  .nova-teaser__close {
    background: transparent; border: 0; color: var(--color-text-muted);
    cursor: pointer; font-size: var(--text-xs); padding: .2rem;
  }
  .nova-teaser__close:hover { color: var(--color-text); }
  /* FIN ELEMENTO 3 */

  /* ELEMENTO 5: chips de preguntas sugeridas (borrar bloque para quitarlos).
     Pills compactas con borde azul NOVA (#38bdf8): el aspecto anterior al
     tema verde. Constantes a propósito, no variables del tema. */
  .nova__chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .nova__chips button {
    font-size: var(--text-xs);
    padding: .35rem .7rem;
    border-radius: var(--radius-full);
    border: 1px solid #38bdf8;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }
  .nova__chips button:hover { background: rgba(56, 189, 248, .15); }
  /* FIN ELEMENTO 5 */
  .nova-dock__fab,
  .nova-dock__face {
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, #05080f 55%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: var(--shadow-lg);
  }
  .nova-dock__fab {
    width: 132px;
    height: 112px;
    padding: 8px 10px;
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }
  .nova-dock__fab:hover { transform: scale(1.05); border-color: var(--color-primary); }
  .nova-dock__fab :global(.nova-face) { width: 100%; max-width: none; }
  /* Cada cara usa sus propios ids SVG (NovaFace los sufija), así que ocultar
     el botón con display:none es seguro. */
  .nova-dock[data-open="true"] .nova-dock__fab { display: none; }

  /* Cara ENCIMA del diálogo, a caballo sobre el borde superior */
  .nova-dock__face {
    width: 132px;
    padding: 8px 10px 4px;
    align-self: center;
    margin-top: -3.4rem; /* la cara asoma por encima del panel */
  }
  .nova-dock__face :global(.nova-face) { width: 100%; max-width: none; }

  /* Panel: MISMA transparencia que el botón */
  .nova-dock__panel {
    width: min(24rem, calc(100vw - 2rem));
    max-height: min(36rem, calc(100vh - 7rem));
    display: flex;
    flex-direction: column;
    gap: .6rem;
    background: color-mix(in srgb, #05080f 55%, transparent);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: var(--shadow-lg);
    padding: 1rem;
    padding-top: 0; /* la cara ocupa el hueco superior */
  }
  .nova-dock__panel[hidden] { display: none; }

  .nova-dock__head {
    display: flex;
    align-items: baseline;
    gap: .5rem;
    margin-top: .6rem;
  }
  .nova-dock__head strong { font-size: var(--text-base); }
  .nova-dock__sub { flex: 1; font-size: var(--text-xs); color: var(--color-text-muted); }
  .nova-dock__close {
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text);
    cursor: pointer;
    width: 1.8rem;
    height: 1.8rem;
    line-height: 1;
  }
  .nova-dock__close:hover { border-color: var(--color-primary); color: var(--color-primary); }

  .nova__log {
    display: flex; flex-direction: column; gap: .5rem;
    overflow-y: auto; min-height: 8rem; max-height: 18rem;
  }
  .nova__msg { margin: 0; padding: .6rem .9rem; border-radius: 12px; max-width: 92%; font-size: var(--text-sm); }
  .nova__msg--nova { background: var(--color-bg-elevated); align-self: flex-start; font-size: 0.75rem; line-height: 1.5; }
  .nova__msg--user { background: var(--color-primary); color: var(--color-text-inverse); align-self: flex-end; }

  /* Pregunta apilada: textarea a ancho completo (como el historial) y botón debajo */
  .nova__form { display: flex; flex-direction: column; gap: .5rem; }
  .nova__form textarea {
    flex: 1; min-width: 0; min-height: 4.2rem; resize: vertical;
    padding: .6rem .9rem; border-radius: 12px; font: inherit; font-size: var(--text-sm);
    border: 1px solid transparent; background: var(--color-bg-elevated); color: var(--color-text);
  }
  .nova__form textarea:focus { outline: none; border-color: var(--color-primary); }
  .nova__form button {
    width: 100%;
    padding: .45rem .8rem; font-size: var(--text-sm); border-radius: 10px; border: 0; cursor: pointer;
    background: var(--color-primary); color: var(--color-text-inverse); font-weight: 700;
  }
  .nova__msg a { color: var(--color-primary); }
  .nova__sources { font-size: var(--text-xs); color: var(--color-text-muted); }
  .nova__sources h3 { font-size: var(--text-xs); text-transform: uppercase;
    letter-spacing: .08em; margin: 0 0 .3rem; }
  .nova__sources ul { margin: 0; padding-left: 1.1rem; }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .nova-dock__fab { transition: none; }
  }
</style>
