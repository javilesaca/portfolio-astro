---
/**
 * ProjectCard — card accesible para la grid de proyectos.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n';
interface Props {
  title: string;
  shortDescription: string;
  techStack: string[];
  role: string;
  image: ImageMetadata;
  imageAlt: string;
  repoUrl: string;
  demoUrl?: string;
  slug: string;
  lang?: Lang;
}
import TechBadge from './TechBadge.astro';
import type { Lang } from '../i18n';
const { title, shortDescription, techStack, role, image, imageAlt, repoUrl, demoUrl, slug, lang = 'es' } = Astro.props as Props & { lang?: Lang };
const base = lang === 'en' ? '/en/projects' : '/proyectos';
---
<article class="card">
  <a href={`${base}/${slug}/`} class="card__media" aria-label={`Ver detalle de ${title}`}>
    <Image src={image} alt={imageAlt} width={800} formats={['avif', 'webp']} loading="lazy" decoding="async" class="card__img" />
  </a>
  <div class="card__body">
    <p class="card__role">{role}</p>
    <h3 class="card__title"><a href={`${base}/${slug}/`}>{title}</a></h3>
    <p class="card__desc">{shortDescription}</p>
    <ul class="card__tags" aria-label="Tecnologías">
      {techStack.slice(0, 4).map((t) => <li><TechBadge name={t} /></li>)}
      {techStack.length > 4 && <li class="card__more" aria-label={`Más tecnologías: ${techStack.slice(4).join(', ')}`}>+{techStack.length - 4}</li>}
    </ul>
    <div class="card__actions">
      <a href={`${base}/${slug}/`} class="card__link">Case study →</a>
      <a href={repoUrl} class="card__link card__link--muted" target="_blank" rel="noopener noreferrer">Repo ↗</a>
      {demoUrl && <a href={demoUrl} class="card__link card__link--muted" target="_blank" rel="noopener noreferrer">Demo ↗</a>}
    </div>
  </div>
</article>
<style>
.card{display:flex;flex-direction:column;height:100%;background:var(--color-bg-elevated);border:1px solid var(--color-border);border-radius:var(--radius-lg);overflow:hidden;transition:transform var(--duration-normal) var(--ease-out),box-shadow var(--duration-normal) var(--ease-out)}
.card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
.card__media{display:block;aspect-ratio:16/9;overflow:hidden;background:var(--color-bg-hover)}
.card__img{width:100%;height:100%;object-fit:cover;transition:transform var(--duration-slow) var(--ease-out)}
.card:hover .card__img{transform:scale(1.04)}
.card__body{display:flex;flex-direction:column;flex:1;padding:var(--space-5)}
.card__desc{flex:0 0 auto}
.card__role{font-size:var(--text-xs);text-transform:uppercase;letter-spacing:.08em;color:var(--color-brand);font-weight:var(--font-weight-semibold);margin-bottom:var(--space-2)}
.card__title{font-size:var(--text-xl);margin-bottom:var(--space-2)}
.card__title a{color:var(--color-text);text-decoration:none}
.card__title a:hover{color:var(--color-brand)}
.card__desc{font-size:var(--text-sm);color:var(--color-text-muted);margin-bottom:var(--space-4)}
.card__tags{display:flex;flex-wrap:wrap;gap:var(--space-2);list-style:none;margin-bottom:var(--space-4)}
.card__tags{margin-top:auto}
.card__tags li{display:flex}
.card__more{font-size:var(--text-xs);font-family:var(--font-mono);color:var(--color-text-muted);align-self:center}
.card__actions{display:flex;gap:var(--space-4);padding-top:var(--space-3)}
.card__link{font-size:var(--text-sm);font-weight:var(--font-weight-medium)}
.card__link--muted{color:var(--color-text-muted)}
</style>
