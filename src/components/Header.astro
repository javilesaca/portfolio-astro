---
/**
 * Header — JaviLesacaPro Portfolio
 * Semantic navigation with logo, nav links, mobile menu button.
 * Accessible: keyboard navigation, ARIA labels, focus management.
 */
import type { Lang } from '../i18n';
import { getDict } from '../i18n';
import LangSelector from './LangSelector.astro';
interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props as Props;
const d = getDict(lang);
// Las secciones viven en la home: desde /proyectos/* o /en/* los fragmentos
// relativos (#inicio) resolverían mal, así que se anclan a la home del idioma.
const home = lang === 'es' ? '/' : `/${lang}/`;
---
<header class="header" role="banner">
  <div class="header__inner container">
    <a href={lang === "en" ? "/en/" : "/"} class="header__logo" aria-label="JaviLesacaPro - Inicio">
      <span class="header__logo-text">Javier Lesaca</span>
      <span class="header__logo-sub">IT Infrastructure & Software Developer</span>
    </a>

    <nav class="header__nav" aria-label="Navegación principal">
      <button
        class="header__menu-toggle"
        aria-expanded="false"
        aria-controls="header-menu"
        aria-label="Abrir menú de navegación"
        data-menu-toggle
      >
        <svg class="header__menu-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg class="header__menu-icon header__menu-icon--close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" hidden>
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>

      <ul id="header-menu" class="header__menu" role="list">
        <li><a href={`${home}#inicio`} class="header__link">{d.header.home}</a></li>
        <li><a href={`${home}#proyectos`} class="header__link">{d.header.projects}</a></li>
        <li><a href={`${home}#sobre-mi`} class="header__link">{d.header.about}</a></li>
        <li><a href={`${home}#contacto`} class="header__link header__link--cta">{d.header.contact}</a></li>
      </ul>

      <button
        class="header__theme"
        type="button"
        data-theme-toggle
        aria-label="Cambiar a tema claro"
        aria-pressed="false"
      >
        <svg class="header__theme-icon header__theme-icon--sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <svg class="header__theme-icon header__theme-icon--moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
      </button>
      <LangSelector lang={lang} currentPath={Astro.url.pathname} />
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .header__logo {
    flex-shrink: 0;
    text-decoration: none;
    color: var(--color-text);
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .header__logo:hover {
    opacity: 0.8;
    text-decoration: none;
  }

  .header__logo-text {
    display: block;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-tight);
  }

  .header__logo-sub {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-weight: var(--font-weight-normal);
  }

  .header__nav {
    display: flex;
    align-items: center;
  }

  .header__menu {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
  }

  .header__link {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out);
  }

  .header__link:hover {
    color: var(--color-brand);
    background: var(--color-brand-muted);
    text-decoration: none;
  }

  .header__link:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .header__link--cta {
    background: var(--color-brand);
    color: var(--color-text-inverse);
  }

  .header__link--cta:hover {
    background: var(--color-brand-hover);
    color: var(--color-text-inverse);
  }

  .header__menu-toggle {
    display: none;
    padding: var(--space-2);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .header__menu-toggle:hover {
    border-color: var(--color-brand);
  }

  .header__menu-toggle:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .header__menu-icon {
    display: block;
  }

  .header__theme {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-left: var(--space-4);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
    flex-shrink: 0;
  }

  .header__theme:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  .header__theme:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .header__theme-icon--moon { display: none; }
  .header__theme[data-mode="light"] .header__theme-icon--sun { display: none; }
  .header__theme[data-mode="light"] .header__theme-icon--moon { display: block; }

  /* Mobile menu */
  @media (max-width: 48rem) {
    .header__menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .header__nav[data-menu-open="true"] .header__menu-icon {
      display: none;
    }

    .header__nav[data-menu-open="true"] .header__menu-icon--close {
      display: block;
    }

    .header__menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      padding: var(--space-4) var(--space-section-x);
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      gap: var(--space-2);
      display: none;
      box-shadow: var(--shadow-lg);
    }

    .header__nav[data-menu-open="true"] .header__menu {
      display: flex;
    }

    .header__link {
      width: 100%;
      text-align: center;
      padding: var(--space-3) var(--space-4);
    }
  }
</style>

<script>
  // Mobile menu toggle
  const toggle = document.querySelector('[data-menu-toggle]');
  const nav = document.querySelector('.header__nav');

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const isOpen = nav.getAttribute('data-menu-open') === 'true';
      nav.setAttribute('data-menu-open', String(!isOpen));
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Abrir menú de navegación' : 'Cerrar menú de navegación');
    });

    // Close menu on link click
    nav.querySelectorAll('.header__link').forEach(link => {
      link.addEventListener('click', () => {
        nav.setAttribute('data-menu-open', 'false');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Abrir menú de navegación');
      });
    });

    // Close menu on escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.getAttribute('data-menu-open') === 'true') {
        nav.setAttribute('data-menu-open', 'false');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Abrir menú de navegación');
        toggle.focus();
      }
    });
  }

  // Theme toggle: stored choice wins, otherwise always dark on boot
  // (OS light preference no longer forces light mode).
  const themeBtn = document.querySelector('[data-theme-toggle]');
  const root = document.documentElement;
  const applyTheme = (mode) => {
    root.setAttribute('data-theme', mode);
    if (themeBtn) {
      themeBtn.setAttribute('data-mode', mode);
      themeBtn.setAttribute('aria-pressed', String(mode === 'light'));
      themeBtn.setAttribute('aria-label', mode === 'light' ? 'Cambiar a tema oscuro' : 'Cambiar a tema claro');
    }
  };
  const stored = localStorage.getItem('theme');
  if (stored === 'light' || stored === 'dark') {
    applyTheme(stored);
  } else {
    applyTheme('dark');
  }
  themeBtn?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    localStorage.setItem('theme', next);
    applyTheme(next);
  });
</script>