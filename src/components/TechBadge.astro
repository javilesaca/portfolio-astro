---
/**
 * TechBadge — insignia de tecnología con icono.
 * Usa devicon (CDN) cuando existe icono; si falla, fallback
 * con la inicial y color determinista. Accesible: texto visible.
 */
interface Props {
  name: string;
}
const { name } = Astro.props;

const key = name.toLowerCase();

// Alias → slug de devicon (https://devicon.dev)
const ICONS: Record<string, string> = {
  'node.js': 'nodejs/nodejs-original',
  'express': 'express/express-original',
  'mongodb': 'mongodb/mongodb-original',
  'react': 'react/react-original',
  'tailwind css': 'tailwindcss/tailwindcss-original',
  'tailwind': 'tailwindcss/tailwindcss-original',
  'docker': 'docker/docker-original',
  'unity': 'unity/unity-original',
  'urp': 'unity/unity-original',
  'dots/ecs': 'unity/unity-original',
  'input system': 'unity/unity-original',
  'cinemachine': 'unity/unity-original',
  'c#': 'csharp/csharp-original',
  'asp.net core': 'dotnetcore/dotnetcore-original',
  'entity framework core': 'dotnetcore/dotnetcore-original',
  'blazor': 'blazor/blazor-original',
  'postgresql': 'postgresql/postgresql-original',
  'vanilla javascript (es6+)': 'javascript/javascript-original',
  'javascript': 'javascript/javascript-original',
  'css custom properties': 'css3/css3-original',
  'css': 'css3/css3-original',
  'html5 semántico': 'html5/html5-original',
  'html': 'html5/html5-original',
  'chart.js': 'chartjs/chartjs-original',
  'git': 'git/git-original',
  'java': 'java/java-original',
  'android sdk': 'android/android-original',
  'android': 'android/android-original',
  'firebase': 'firebase/firebase-original',
  'firebase auth': 'firebase/firebase-original',
  'firestore': 'firebase/firebase-plain',
  'room': 'sqlite/sqlite-original',
  'sqlite': 'sqlite/sqlite-original',
  'retrofit': 'android/android-plain',
  'workmanager': 'android/android-plain',
  'signalr': 'dotnetcore/dotnetcore-original',
  'redis': 'redis/redis-original',
  'yarp': 'dotnetcore/dotnetcore-plain',
  'typescript': 'typescript/typescript-original',
  'linux': 'linux/linux-original',
  'java': 'java/java-original',
  // Sin icono en devicon: SVG local servido desde /public/icons
  'javafx': '/icons/javafx.svg',
};

const slug = ICONS[key];
const src = slug ? (slug.startsWith('/') ? slug : `https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${slug}.svg`) : null;
const initial = name.trim().charAt(0).toUpperCase();

// Color determinista para el fallback (hash simple del nombre)
let hash = 0;
for (const ch of key) hash = (hash * 31 + ch.charCodeAt(0)) % 360;
const fallbackBg = `hsl(${hash} 45% 35% / 0.9)`;
---
<span class="tech" data-name={name} role="img" aria-label={name} tabindex="0">
  {src ? (
    <img
      class="tech__icon"
      src={src}
      alt=""
      aria-hidden="true"
      loading="lazy"
      width="16"
      height="16"
      data-tech-icon
    />
    <span class="tech__fallback" style={`background:${fallbackBg}`}>{initial}</span>
  ) : (
    <span class="tech__fallback tech__fallback--only" style={`background:${fallbackBg}`}>{initial}</span>
  )}
</span>

<style>
  .tech {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    background: var(--color-bg-hover);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: default;
  }
  /* Tooltip burbuja con el nombre */
  .tech::after {
    content: attr(data-name);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: var(--color-text);
    color: var(--color-bg);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
    z-index: var(--z-tooltip);
  }
  .tech:hover::after,
  .tech:focus-visible::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .tech:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }
  .tech__icon { width: 16px; height: 16px; flex-shrink: 0; }
  .tech__fallback {
    display: none;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .tech__fallback--only { display: inline-flex; }
</style>

<script>
  // Si un icono devicon falla (slug inexistente), muestra el fallback con inicial
  document.querySelectorAll('img[data-tech-icon]').forEach((img) => {
    img.addEventListener('error', () => {
      const badge = img.closest('.tech');
      const fallback = badge?.querySelector('.tech__fallback');
      if (fallback instanceof HTMLElement) {
        img.remove();
        fallback.style.display = 'inline-flex';
      }
    });
  });
</script>
