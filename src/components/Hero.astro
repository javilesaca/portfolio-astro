---
/**
 * Hero — JaviLesacaPro Portfolio
 * Hero section with name, title, CTAs, social links.
 * Semantic, accessible, responsive.
 */
import type { Lang } from '../i18n';
import { getDict } from '../i18n';
interface Props {
  name?: string;
  title?: string;
  description?: string;
  lang?: Lang;
}
import { Image } from 'astro:assets';
import perfilSrc from '../assets/perfil.png';
const { name = 'Javier Lesaca', title = 'IT Infrastructure & Software Developer', description = 'Infraestructura IT, desarrollo de software, automatización e IA aplicada. Del sistema al código: soluciones robustas y modernas.', lang = 'es' } = Astro.props;
const d = getDict(lang);
---
<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="hero__inner container">
    <div class="hero__photo">
      <Image
        src={perfilSrc}
        alt="Foto de perfil de Javier Lesaca"
        width={480}
        height={480}
        formats={['avif', 'webp', 'png']}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero__content">
      <h1 id="hero-title" class="hero__name">{name}</h1>
      <p class="hero__title">{title}</p>
      <p class="hero__description">{description}</p>

      <div class="hero__actions" role="group" aria-label="Acciones principales">
        <a href="#proyectos" class="btn btn--sm btn--secondary">{d.hero.projects}</a>
        <a href="#contacto" class="btn btn--sm btn--secondary">{d.hero.contact}</a>
      </div>

      <nav class="hero__social" aria-label="Perfiles profesionales">
        <ul class="hero__social-list" role="list">
          <li>
            <a href="https://github.com/javilesaca" class="hero__social-link" aria-label="GitHub - javilesaca" target="_blank" rel="noopener noreferrer">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.37 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.28-1.56 3.285-1.23 3.285-1.23.66 1.65.24 2.88.12 3.18.765.855 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
              </svg>
            </a>
          </li>
          <li>
            <a href="https://linkedin.com/in/javilesacapro" class="hero__social-link" aria-label="LinkedIn - Javier Lesaca" target="_blank" rel="noopener noreferrer">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            </a>
          </li>
          <li>
            <a href="mailto:javilesaca@javilesaca.pro" class="hero__social-link" aria-label="Email - javilesaca@javilesaca.pro">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            </a>
          </li>
        </ul>
      </nav>
    </div>

  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-20);
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .hero__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-12);
    max-width: 100%;
    overflow-x: clip;
  }

  .hero__content {
    max-width: 36rem;
    min-width: 0;
    text-align: left;
  }

  .hero__photo {
    flex-shrink: 0;
  }

  .hero__photo img {
    width: 15rem;
    height: 15rem;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 3px solid var(--color-brand);
    box-shadow: var(--shadow-lg);
  }

  @media (max-width: 48rem) {
    .hero__inner {
      flex-direction: column;
      gap: var(--space-8);
    }

    .hero__content {
      text-align: center;
      max-width: 100%;
      width: 100%;
    }


    .hero__photo img {
      width: 11rem;
      height: 11rem;
    }

    .hero__actions,
    .hero__social-list {
      justify-content: center;
    }
  }

  .hero__name {
    font-size: var(--text-5xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-3);
    color: var(--color-text);
  }

  .hero__title {
    font-size: clamp(1rem, 1rem + 1.5vw, var(--text-2xl));
    white-space: nowrap;
    font-family: var(--font-sans);
    font-weight: var(--font-weight-medium);
    color: var(--color-brand);
    margin-bottom: var(--space-4);
  }

  .hero__description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 48ch;
    margin: 0 0 var(--space-8);
    line-height: var(--leading-relaxed);
  }


  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }


  .hero__social {
    margin-top: var(--space-8);
  }

  .hero__social-list {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }


  .hero__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition: color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .hero__social-link:hover {
    color: var(--color-brand);
    border-color: var(--color-brand);
    background: var(--color-brand-muted);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .hero__social-link:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  /* Mobile title: single line that always fits (placed last to win the cascade) */
  @media (max-width: 48rem) {
    .hero__inner .hero__content .hero__title {
      font-size: 3.7vw;
      letter-spacing: 0;
    }
  }

</style>

